{
  // No rule is switched off here, and that is the point: lint:markdown was red
  // on seven findings, six of which are in files this repository does not
  // write. `.gitlab/**` is synced from devops/repo-templates (see the
  // `chore(repo-templates): sync …` commits), so a fix here would be undone by
  // the next sync — and MD041 is wrong for those files anyway: a GitLab issue
  // template is a fragment dropped into a form, not a document that starts
  // with an H1.
  //
  // Same reasoning for the rest: CHANGELOG.md is generated by
  // semantic-release, and vendor/ is other people's code.
  //
  // The seventh finding was ours (a table in CLAUDE.md without the blank line
  // before it) and is fixed rather than ignored.
  "ignores": [
    ".gitlab/**",
    "CHANGELOG.md",
    "vendor/**",
    "node_modules/**",
    "public/**",
    "var/**"
  ]
}
