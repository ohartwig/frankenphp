<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
	<file source-language="en" datatype="plaintext" original="EXT:frankenphp/Resources/Private/Language/locallang.xlf" date="2025-01-01T00:00:00Z">
		<header/>
		<body>
			<trans-unit id="extension.title">
				<source>Caddy Cache Handler</source>
			</trans-unit>
			<trans-unit id="extension.description">
				<source>TYPO3 Plugin for invalidating Caddy cache via REST-API using Souin cache handler</source>
			</trans-unit>

			<!-- Module Labels (TYPO3 standard keys for backend module menu) -->
			<trans-unit id="mlang_tabs_tab">
				<source>Caddy Cache Management</source>
			</trans-unit>
			<trans-unit id="mlang_labels_tabdescr">
				<source>Manage Caddy cache invalidation for your TYPO3 sites.</source>
			</trans-unit>
			<trans-unit id="mlang_labels_tablabel">
				<source>HTTP Cache / CDN</source>
			</trans-unit>
			<!-- Legacy module labels -->
			<trans-unit id="module.title">
				<source>Caddy Cache Management</source>
			</trans-unit>
			<trans-unit id="module.description">
				<source>Manage Caddy cache invalidation for your TYPO3 sites.</source>
			</trans-unit>

			<!-- Flush All Section -->
			<trans-unit id="flush_all.title">
				<source>Flush All Cache</source>
			</trans-unit>
			<trans-unit id="flush_all.description">
				<source>This will flush the Caddy cache for all configured sites.</source>
			</trans-unit>
			<trans-unit id="button.flush_all">
				<source>Flush All Cache</source>
			</trans-unit>

			<!-- Flush Site Section -->
			<trans-unit id="flush_site.title">
				<source>Flush Site Cache</source>
			</trans-unit>
			<trans-unit id="flush_site.description">
				<source>Flush cache for individual sites.</source>
			</trans-unit>
			<trans-unit id="button.flush_site">
				<source>Flush Site Cache</source>
			</trans-unit>

			<!-- Table Headers -->
			<trans-unit id="table.site_identifier">
				<source>Site Identifier</source>
			</trans-unit>
			<trans-unit id="table.base_url">
				<source>Base URL</source>
			</trans-unit>
			<trans-unit id="table.languages">
				<source>Languages</source>
			</trans-unit>
			<trans-unit id="table.actions">
				<source>Actions</source>
			</trans-unit>

			<!-- Status Section -->
			<trans-unit id="status.title">
				<source>Cache Status</source>
			</trans-unit>
			<trans-unit id="status.automatic">
				<source>Automatic Cache Invalidation:</source>
			</trans-unit>
			<trans-unit id="status.automatic_description">
				<source>Cache will be automatically invalidated when pages or content are updated in TYPO3.</source>
			</trans-unit>

			<!-- Messages -->
			<trans-unit id="no_sites">
				<source>No sites configured.</source>
			</trans-unit>

			<!-- Log Messages -->
			<trans-unit id="log.page_updated">
				<source>Page updated - invalidating cache</source>
			</trans-unit>
			<trans-unit id="log.content_updated">
				<source>Content updated - invalidating cache</source>
			</trans-unit>
			<trans-unit id="log.cache_flushed">
				<source>Cache flushed successfully</source>
			</trans-unit>
			<trans-unit id="log.cache_flush_error">
				<source>Error flushing cache</source>
			</trans-unit>
		</body>
	</file>
</xliff>
