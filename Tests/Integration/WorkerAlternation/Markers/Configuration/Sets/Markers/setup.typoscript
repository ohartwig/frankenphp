# Every request renders in full: the test is about the render path, not the
# page cache.
config {
    no_cache = 1
    admPanel = 0
}

page = PAGE
page {
    # Meta tag, inline JavaScript and a style sheet for this page and language,
    # through PageRenderer and AssetCollector, see PageAssets.
    5 = USER
    5.userFunc = Koh\FrankenPHP\Tests\Integration\WorkerAlternation\Markers\PageAssets->render

    # Markers computed in PHP, see MarkerRenderer.
    10 = USER_INT
    10 {
        userFunc = Koh\FrankenPHP\Tests\Integration\WorkerAlternation\Markers\MarkerRenderer->render
        # The page each page links to as its "other" page (default-language uids).
        otherPage {
            1 = 2
            2 = 1
            10 = 11
            11 = 10
        }
        # The greeting each site reads through Extbase (by root page id).
        greetingUid {
            1 = 1
            10 = 2
        }
    }

    # The same facts through TypoScript's own data providers and typolink.
    20 = COA
    20 {
        wrap = <ul id="worker-alternation-typoscript">|</ul>
        10 = TEXT
        10.data = site:identifier
        10.wrap = <li data-marker="ts.site.identifier">|</li>
        20 = TEXT
        20.data = getIndpEnv:HTTP_HOST
        20.wrap = <li data-marker="ts.indpenv.http_host">|</li>
        30 = TEXT
        30.data = siteLanguage:languageId
        30.wrap = <li data-marker="ts.language.id">|</li>
        40 = TEXT
        40.data = page:title
        40.htmlSpecialChars = 1
        40.wrap = <li data-marker="ts.page.title">|</li>
        50 = TEXT
        50.typolink {
            parameter.data = page:uid
            forceAbsoluteUrl = 1
            returnLast = url
        }
        50.wrap = <li data-marker="ts.link.self">|</li>
    }

    # Fluid through a global namespace (no namespace declaration in the
    # template), see MarkerViewHelper.
    25 = FLUIDTEMPLATE
    25.file = EXT:worker_alternation_markers/Resources/Private/Templates/FluidMarkers.html

    # The main menu: both pages of the site, the current one marked.
    30 = HMENU
    30 {
        special = list
        wrap = <ul id="worker-alternation-menu">|</ul>
        1 = TMENU
        1 {
            NO.wrapItemAndSub = <li data-menu="no">|</li>
            ACT = 1
            ACT.wrapItemAndSub = <li data-menu="act">|</li>
            CUR = 1
            CUR.wrapItemAndSub = <li data-menu="cur">|</li>
        }
    }

    # The last content object: the global request must still be this one.
    90 = USER_INT
    90.userFunc = Koh\FrankenPHP\Tests\Integration\WorkerAlternation\Markers\MarkerRenderer->renderLate

    # LateStateMiddleware replaces this once the page has been rendered.
    100 = TEXT
    100.value = <!--worker-alternation-late-->
}

# Head tags that go through MetaTagManagerRegistry (page.meta here, the
# description and Open Graph tags from the page record through EXT:seo),
# next to canonical and hreflang from EXT:seo and JSON-LD in the header data.
page.meta {
    og:url.attribute = property
    og:url.typolink {
        parameter.data = page:uid
        forceAbsoluteUrl = 1
        returnLast = url
    }
}
page.headerData.30 = COA
page.headerData.30 {
    wrap = <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage",|}</script>
    10 = TEXT
    10.typolink {
        parameter.data = page:uid
        forceAbsoluteUrl = 1
        returnLast = url
    }
    10.wrap = "@id":"|#webpage",
    20 < .10
    20.wrap = "url":"|"
}

[site("identifier") == "site-a"]
    page.30.special.value = 1,2
[site("identifier") == "site-b"]
    page.30.special.value = 10,11
[END]

# Forms of the form framework, rendered on the page itself (no content
# element needed): the single-page form on the second page of each site, the
# two-page form on the root page.
lib.workerAlternationForm = EXTBASEPLUGIN
lib.workerAlternationForm {
    extensionName = Form
    pluginName = Formframework
}

[site("identifier") == "site-a" && page["uid"] == 2]
    page.40 < lib.workerAlternationForm
    page.40.settings.persistenceIdentifier = EXT:worker_alternation_markers/Resources/Private/Forms/wa-contact-a.form.yaml
[site("identifier") == "site-b" && page["uid"] == 11]
    page.40 < lib.workerAlternationForm
    page.40.settings.persistenceIdentifier = EXT:worker_alternation_markers/Resources/Private/Forms/wa-contact-b.form.yaml
[site("identifier") == "site-a" && page["uid"] == 1]
    page.40 < lib.workerAlternationForm
    page.40.settings.persistenceIdentifier = EXT:worker_alternation_markers/Resources/Private/Forms/wa-steps-a.form.yaml
[site("identifier") == "site-b" && page["uid"] == 10]
    page.40 < lib.workerAlternationForm
    page.40.settings.persistenceIdentifier = EXT:worker_alternation_markers/Resources/Private/Forms/wa-steps-b.form.yaml
[END]
