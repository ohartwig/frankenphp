{
    "name": "koh/frankenphp-worker-alternation-markers",
    "description": "Test-only extension for the worker alternation test: renders what TYPO3 believes about the current request",
    "license": "MIT",
    "type": "typo3-cms-extension",
    "require": {
        "typo3/cms-core": "^14.0",
        "typo3/cms-extbase": "^14.0",
        "typo3/cms-form": "^14.0",
        "typo3/cms-frontend": "^14.0",
        "typo3/cms-seo": "^14.0"
    },
    "autoload": {
        "psr-4": {
            "Koh\\FrankenPHP\\Tests\\Integration\\WorkerAlternation\\Markers\\": ""
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "worker_alternation_markers"
        }
    }
}
